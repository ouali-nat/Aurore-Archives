{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aurore-pdf-gotenberg",
  "main": "src/index.js",
  "compatibility_date": "2026-09-18",
  "containers": [{"class_name":"GotenbergContainer","image":"gotenberg/gotenberg:8-chromium","max_instances":2}],
  "durable_objects": {"bindings":[{"name":"GOTENBERG","class_name":"GotenbergContainer"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["GotenbergContainer"]}]
}
